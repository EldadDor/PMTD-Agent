# Placeholder only. Spring Boot does not automatically read .env files.
# Set this in the process environment before starting the app.
PMTD_PORT=8080

# Future approved PostgreSQL startup only: SPRING_PROFILES_ACTIVE=postgres
# This profile runs Flyway migrations. Confirm the target/schema and execution
# authorization first. The schema must already exist; no database is created.
# Set actual values in the process environment or IntelliJ run configuration.
# The following placeholders are deliberately commented out.
# PMTD_DB_HOST=<laptop-address>
# PMTD_DB_PORT=<confirmed-port>
# PMTD_DB_NAME=<approved-database>
# PMTD_DB_USERNAME=<local-username>
# PMTD_DB_PASSWORD=<local-password>
# PMTD_DB_SCHEMA=<existing-dedicated-schema>
# PMTD_DB_SSLMODE=<agreed-TLS-mode>

# Optional integration tests use a SEPARATE disposable database/schema, never
# PMTD_DB_* settings. These tests apply V1 and retain synthetic data afterward.
# PMTD_TEST_DB_HOST=<approved-test-host>
# PMTD_TEST_DB_PORT=<test-port>
# PMTD_TEST_DB_NAME=<disposable-test-database>
# PMTD_TEST_DB_USERNAME=<test-username>
# PMTD_TEST_DB_PASSWORD=<test-password>
# PMTD_TEST_DB_SCHEMA=pmtd_test_<unique-suffix>
# PMTD_TEST_DB_SSLMODE=<test-TLS-mode>
